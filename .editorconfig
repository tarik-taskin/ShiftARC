root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{js,jsx,ts,tsx,json,jsonc,yml,yaml,css,scss,html,xml}]
indent_style = space
indent_size = 2

[*.{java,kt,kts,gradle}]
indent_style = space
indent_size = 4

[*.sql]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf

[Makefile]
indent_style = tab
